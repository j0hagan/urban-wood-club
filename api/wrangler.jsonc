{
  "name": "urban-wood-club-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true, "persist": true }
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "urban-wood-club", "database_id": "0ed21153-04a4-427d-bcb8-e0f1acb7de6f" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "urban-wood-club-photos" }
  ],
  // Workers AI - used for Dutch->English permit-title translation
  // (api/src/ingest/bekendmakingen.ts's translateToEnglish()), added
  // 2026-09-08 to replace MyMemory as the primary translator: MyMemory's
  // free anonymous API is IP-rate-limited, and Cloudflare Workers share
  // egress IPs across every customer on the platform, so that quota was
  // almost certainly already exhausted before this Worker's own requests
  // ever went out - every production translation came back null even
  // though the exact same code worked fine testing from a real machine's
  // own IP via `wrangler dev`. Workers AI runs inside Cloudflare's own
  // infrastructure instead, so it isn't subject to that failure mode.
  // MyMemory is kept as a fallback in translateToEnglish() in case Workers
  // AI itself is ever unavailable.
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    // daily at 03:00 UTC — permit announcements don't need tighter polling
    "crons": ["0 3 * * *"]
  }
  // New-report email alerts (POST /api/reports in src/index.ts) go through
  // Resend's HTTP API now, not a Workers binding - see the Env.RESEND_API_KEY
  // comment in src/index.ts for why the switch. That means there's nothing
  // to declare here: the API key is a plain secret, set once from your
  // terminal with `wrangler secret put RESEND_API_KEY` (paste the key from
  // resend.com when prompted) rather than committed to this file. The old
  // send_email binding this file used to declare (Cloudflare's own Email
  // Routing product) has been removed along with the code that used it.
}
