{
  "name": "urban-wood-club-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true, "persist": true }
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "urban-wood-club", "database_id": "0ed21153-04a4-427d-bcb8-e0f1acb7de6f" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "urban-wood-club-photos" }
  ],
  "triggers": {
    // daily at 03:00 UTC — permit announcements don't need tighter polling
    "crons": ["0 3 * * *"]
  },
  // New-report email alerts (POST /api/reports in src/index.ts), sent
  // "From: info@urbanwood.club" - that address is just the sender identity
  // (needs the zone onboarded to Email Routing, nothing more); the actual
  // inbox that receives the alert is the destination_address below, which
  // must be verified separately (Cloudflare Dashboard > Email > Email
  // Routing > Destination addresses). If you also want people to be able
  // to email info@urbanwood.club and have it land somewhere, add a routing
  // rule there too (Custom address "info" -> Send to email -> this same
  // verified address) - a destination address on your own routed domain
  // can never verify itself, since there's no real mailbox to receive its
  // confirmation link. A send_email binding to an unverified destination
  // is silently rejected at send time, not a config error - the code wraps
  // the send in try/catch either way, so a report submission itself never
  // fails because of this.
  "send_email": [
    { "name": "SEND_EMAIL", "destination_address": "j.ohagan.tud@gmail.com" }
  ]
}
