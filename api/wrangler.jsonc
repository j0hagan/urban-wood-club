{
  "name": "urban-wood-club-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "urban-wood-club", "database_id": "0ed21153-04a4-427d-bcb8-e0f1acb7de6f" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "urban-wood-club-photos" }
  ],
  "triggers": {
    // daily at 03:00 UTC — permit announcements don't need tighter polling
    "crons": ["0 3 * * *"]
  }
}
