{
  "name": "urban-wood-club-app",
  "compatibility_date": "2026-09-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "services": [
    { "binding": "API", "service": "urban-wood-club-api" }
  ]
}
